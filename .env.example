# ─────────────────────────────────────────────────────────────
#  AetherBrackets bot — settings
#  Local: copy this file to ".env" and fill it in.
#  Railway: add these under your service → Variables.
# ─────────────────────────────────────────────────────────────

# REQUIRED — Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=

# DATABASE — MongoDB connection string.
#   Railway: add a MongoDB database (+ New → Database → MongoDB) and set this to
#            ${{MongoDB.MONGO_URL}}   (Railway fills in the address and password)
#   Elsewhere: any MongoDB URL, e.g. a free MongoDB Atlas cluster.
# Leave empty to store data in a JSON file instead (on Railway, attach a Volume so it survives redeploys).
MONGODB_URI=
# MONGODB_DB=aetherbrackets

# OPTIONAL — folder for the JSON database. Railway Volumes are detected automatically.
# DATA_DIR=./data

# OPTIONAL — branding
# BRAND_NAME=AetherBrackets
# BRAND_COLOR=#7C5CFF
# BRAND_COLOR_2=#22D3EE
# STATUS_TEXT=AetherBrackets

# OPTIONAL — how parts 2+ of a long announcement show the ping:
#   tag (default) = small "↳ Part 2 of 3 · @everyone" line · hidden = ping behind a tiny spoiler · full = big ping line again
# EXTRA_PING_STYLE=tag

# OPTIONAL — who is notified when a pinged announcement is split into several messages:
#   once (default) = only part 1 notifies; parts 2+ turn gold with a quick edit (they show a small "(edited)")
#   every          = every part notifies (no "(edited)", but one notification per part)
# EXTRA_PING_NOTIFY=once
