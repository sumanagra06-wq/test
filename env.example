# ─────────────────────────────────────────────────────────────
#  AetherBrackets bot — settings
#  Local: copy this file to ".env" and fill it in.
#  Railway: add these under your service → Variables.
# ─────────────────────────────────────────────────────────────

# REQUIRED — Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=

# OPTIONAL — MongoDB connection string (e.g. a free MongoDB Atlas cluster).
# Leave empty to store data in a JSON file (use a Railway Volume so it survives redeploys).
MONGODB_URI=
# MONGODB_DB=aetherbrackets

# OPTIONAL — folder for the JSON database. Railway Volumes are detected automatically.
# DATA_DIR=./data

# OPTIONAL — branding
# BRAND_NAME=AetherBrackets
# BRAND_COLOR=#7C5CFF
# BRAND_COLOR_2=#22D3EE
# STATUS_TEXT=AetherBrackets
